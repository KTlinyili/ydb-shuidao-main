# === 服务配置 ===
APP_HOST=0.0.0.0
APP_PORT=8000
REQUEST_TIMEOUT=45
RUN_DIR=runs
CASES_DIR=case_library
KB_DIR=knowledge_bases

# === LLM 配置（至少配一组）===
# 方案1: Silicon Flow（免费额度）
SILICONFLOW_API_KEY=你的密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# 方案2: DNXAPI
DNXAPI_BASE_URL=你的密钥
DNXAPI_API_KEY=你的密钥
DNXAPI_MODEL=你的密钥
DNXAPI_TRUST_ENV=true

# 方案3: OpenAI兼容
BASELINE_OPENAI_BASE_URL=你的密钥
BASELINE_OPENAI_API_KEY=你的密钥
BASELINE_OPENAI_MODEL=gpt-4o-mini

# 方案4: 本地Ollama（不需要API key）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:2b

# === 多Agent会诊配置 ===
MULTIAGENT_LLM=baseline_openai
MULTIAGENT_OPENAI_MODEL=gpt-4o-mini
N_ROUNDS=1
MAX_EXPERT_RETRIES=1
MAX_PARALLEL_AGENTS_PER_LAYER=3
MAX_CONCURRENCY_PER_ROUTE=2

# === 模型配置 ===
ENABLE_LOCAL_QWEN3_VL=false
ENABLE_LOCAL_DINOV3=false
DINOV3_CLASSIFIER_CLASSES_JSON=["rice_blast","sheath_blight","bacterial_leaf_blight","brown_spot","bacterial_stripe","rice_planthopper","rice_leaf_roller","rice_stem_borer"]

# === 其他 ===
ENABLE_OFFLINE_DEFAULT=true
STRICT_REAL_OUTPUT=false
AGENT_MODEL_ROUTING_JSON=
